<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Authors>Iluay</Authors>
        <Version>0.1.0.0</Version>
        <Description>Attack / Defense / Auto buttons next to the Eureka magia board.</Description>
        <IsPackable>false</IsPackable>
        <TargetFramework>net10.0-windows7.0</TargetFramework>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>
    <ItemGroup>
      <PackageReference Update="DalamudPackager" Version="15.0.0" />
      <PackageReference Include="KamiToolKit" Version="2.2.65" />
    </ItemGroup>
    <ItemGroup>
      <Content Include="Assets\**\*.png" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
</Project>
